<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="invoice_view_form" model="ir.ui.view">
			<field name="name">account_move_peruvian_inherit_form</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
					<field name="tipo_cambio_dolar_sistema" />
				</xpath>
				<xpath expr="//field[@name='currency_id']" position="after">
					<!--<field name="annul" invisible="not annul" />-->
					<field name="move_type" invisible="1" />
					<field name="highest_name" invisible="1" />
				</xpath>
				<xpath expr="//field[@name='invoice_date']" position="after">
					<field name="fecha_nota_credito_proveedor" invisible="move_type != 'in_refund'" />
				</xpath>

				<xpath expr="//button[@name='button_cancel']" position="after">
					<button name="button_annul" class="btn btn-danger" type="object" confirm="¿Seguro que quiere anular esta factura en Sunat? Los datos ya no podrán ser editados una vez anulado el comprobante y el número ya no podrá usarse mas" string="Anular Factura" invisible="state != 'posted' or estado_sunat not in ['05', '09', '07']" groups="account.group_account_invoice" />

					<button name="consultar_estado_sunat" string="Consultar" type="object" invisible="not is_cpe" groups="solse_pe_cpe.group_solse_pe_cpe_manager" />

					<button name="agregegar_a_resumen" string="Agregar a resumen" type="object" invisible="not is_cpe" groups="base.group_no_one" />
				</xpath>
				<xpath expr="//button[@name='button_cancel']" position="attributes">
					<attribute name="invisible">1</attribute>
				</xpath>

				<xpath expr="//widget[@name='web_ribbon']" position="after">
					<widget name="web_ribbon" title="Anulado" bg_color="bg-danger" invisible="state != 'annul'" />
				</xpath>
				<xpath expr="//field[@name='partner_id']" position="attributes">
					<attribute name="context">{'search_default_customer':1, 'show_address': 1, 'default_company_type': 'company','force_pe_journal':True}</attribute>
				</xpath>
				<xpath expr="//button[@name='button_draft']" position="replace">
					<button name="button_draft" string="Regresar a borrador" type="object" groups="account.group_account_invoice" invisible="restrict_mode_hash_table or state in ('draft','cancel','annul')" />
				</xpath>
				<xpath expr="//sheet/div[2]" position="replace">
					<div>
						<group>
							<group>
								<div>
									<!-- Invoice draft header -->
									<span class="o_form_label">
										<field name="move_type" invisible="move_type == 'entry' or state == 'draft'" readonly="1" nolabel="1" />
									</span>
									<h1>
										<span invisible="move_type != 'out_invoice' or state != 'draft' or name != '/'">Draft Invoice</span>
										<span invisible="move_type != 'out_refund' or state != 'draft' or name != '/'">Draft Credit Note</span>
										<span invisible="move_type != 'in_invoice' or state != 'draft' or name != '/'">Draft Bill</span>
										<span invisible="move_type != 'in_refund' or state != 'draft' or name != '/'">Draft Refund</span>
										<span invisible="move_type != 'out_receipt' or state != 'draft' or name != '/'">Draft Sales Receipt</span>
										<span invisible="move_type != 'in_receipt' or state != 'draft' or name != '/'">Draft Purchase Receipt</span>
									</h1>

									<!-- Number -->
									<h1 class="mt0">
										<field name="name" readonly="1" invisible="name == '/'" />
									</h1>
								</div>
							</group>
							<group>
								<div>
									<field name="sunat_qr_code" class="o_field_image oe_avatar" widget="image" options="{'size': [75, 75]}" invisible="state in ['draft','cancel']" />
								</div>
							</group>
						</group>
					</div>
				</xpath>
				<xpath expr="//div[@name='journal_div']" position="after">
					<field name="pe_sunat_transaction" invisible="1" />
					<field name="pe_sunat_transaction51" invisible="not is_cpe" />
					<field name="estado_sunat" invisible="not is_cpe" />
					<field name="tipo_transaccion" invisible="1" force_save="1" />

					<field name="pe_license_plate" groups="solse_pe_edi.group_plate_invoice" />
				</xpath>
				<!-- Campos adicionales en las líneas de factura - usando xpath más compatible con Odoo 18 -->
				<xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="after">
					<field name="move_type" invisible="1" optional="hide" />
					<field name="pe_license_plate" groups="solse_pe_edi.group_plate_invoice_line" optional="hide" />
					<field name="pe_affectation_code" groups="solse_pe_cpe.group_solse_pe_cpe_user" force_save="1" required="1" invisible="1" optional="hide"/>
				</xpath>
				<xpath expr="//page[@name='other_info']" position="after">
					<page string="Personalización Peruana" name="peruvian_customization" invisible="not is_cpe">
						<group>
							<group>
								<field name="pe_cpe_id" readonly="state != 'draft'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_summary_id" invisible="pe_invoice_code not in ('03','07','08') and origin_doc_code not in ('01',)" readonly="1" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_voided_id" readonly="1" invisible="state != 'annul'" />
								<field name="pe_debit_note_code" invisible="pe_invoice_code != '08'" required="pe_invoice_code == '08'" />
								<field name="pe_credit_note_code" invisible="pe_invoice_code != '07'" required="pe_invoice_code == '07'" />
								<field name="is_cpe" invisible="1" />
								<field name="pe_invoice_state" invisible="1" />
								<field name="pe_response" invisible="not is_cpe and state == 'draft'" />
							</group>
							<group>
								<field name="pe_additional_type" />
								<field name="pe_additional_number" invisible="pe_additional_type not in ['04','05', '99', '01', '02', '03']" required="pe_additional_type in ['04','05', '99', '01', '02', '03']" />
								<field name="pe_error_code" />
								<field name="origin_doc_code" invisible="pe_invoice_code not in ['07','08']" required="pe_invoice_code in ['07','08']" />
								<field name="origin_doc_number" invisible="pe_invoice_code not in ['07','08']" required="pe_invoice_code in ['07','08']" />
								<field name="pe_invoice_code" invisible="1" />
								<field name="sunat_estado_manual"/>
							</group>
						</group>
						<div>
							<label for="pe_digest" string="Valor de resumen:" />
							<field name="pe_digest" />
						</div>
						<div>
							<label for="pe_signature" string="Valor de la firma:" />
						</div>
						<div>
							<field name="pe_signature" />
						</div>
						<field name="pe_additional_total_ids" readonly="pe_invoice_state in ['send','verify','done']">
							<list editable="bottom" string="Total monto adicional">
								<field name="code" />
								<field name="total_amount" />
							</list>
						</field>
						<field name="pe_additional_property_ids" readonly="pe_invoice_state in ['send','verify','done']">
							<list editable="bottom" string="Propiedad adicional">
								<field name="code" />
								<field name="value" />
							</list>
						</field>
					</page>
				</xpath>
			</field>
		</record>

	   <record id="view_invoice_tree" model="ir.ui.view">
			<field name="name">account_move_peruvian_inherit_form</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_invoice_tree" />
			<field name="arch" type="xml">
				<!-- Agregar campo estado_sunat después del campo name en la vista tree -->
				<xpath expr="//field[@name='name']" position="after">
					<field name="estado_sunat" optional="show" />
				</xpath>
			</field>
		</record>

		<!-- Vista heredada para agregar campo mostrar_base a account.tax.group -->
		<record id="view_tax_group_form" model="ir.ui.view">
			<field name="name">account_tax_group_peruvian_inherit_form</field>
			<field name="model">account.tax.group</field>
			<field name="inherit_id" ref="account.view_tax_group_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='sequence']" position="after">
					<field name="mostrar_base" />
				</xpath>
			</field>
		</record>

	</data>
</odoo>
