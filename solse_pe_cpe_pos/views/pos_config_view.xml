<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Peru document and client settings after the ePos Printer setting -->
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Documentos de venta" help="Tipos de comprobante habilitados para este POS">
                    <field name="documento_venta_ids"
                        widget="many2many_tags"
                        context="{'default_sub_type': 'sale', 'default_company_id': company_id}"
                        domain="[('company_id', '=', company_id), ('sub_type', '=', 'sale')]"/>
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="doc_venta_defecto" string="Documento por Defecto" class="col-lg-4 o_light_label"/>
                            <field name="doc_venta_defecto" class="col-lg-8" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
                <setting string="Cliente varios" help="Cliente por defecto para ventas sin identificación">
                    <field name="cliente_varios"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
